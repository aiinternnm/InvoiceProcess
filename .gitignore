# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets — never commit the real service-account key
credentials/*
!credentials/README.txt

# Never commit machine-local config variants
config.local.json
config.office.json

# Packaging artifacts
*.zip

# Runtime state generated by the pipeline (auto-created on start)
data/
*.log

# Excel / temp
*.xlsx~
*.xls~
*.tmp
*.tmp.xlsx

# OS junk
Thumbs.db
.DS_Store
desktop.ini